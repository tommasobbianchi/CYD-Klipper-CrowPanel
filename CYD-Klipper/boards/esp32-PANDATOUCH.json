{
  "build": {
    "arduino": {
      "ldscript": "esp32s3_out.ld",
      "partitions": "default_16MB.csv",
      "memory_type": "qio_opi"
    },
    "core": "esp32",
    "extra_flags": [
      "-DBOARD_HAS_PSRAM",
      "-DCYD_SCREEN_HEIGHT_PX=480",
      "-DCYD_SCREEN_WIDTH_PX=800",
      "-DCYD_SCREEN_GAP_PX=16",
      "-DCYD_SCREEN_MIN_BUTTON_HEIGHT_PX=80",
      "-DCYD_SCREEN_MIN_BUTTON_WIDTH_PX=80",
      "-DCYD_SCREEN_FONT=lv_font_montserrat_32",
      "-DCYD_SCREEN_FONT_SMALL=lv_font_montserrat_24",
      "-DCYD_SCREEN_SIDEBAR_SIZE_PX=100",
      "-DCYD_SCREEN_DRIVER_ESP32_PANDATOUCH=1",
      "-DCYD_SCREEN_DISABLE_TOUCH_CALIBRATION=1"
    ],
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "hwids": [
      [
        "0x303A",
        "0x1001"
      ]
    ],
    "mcu": "esp32s3",
    "variant": "esp32s3"
  },
  "connectivity": [
    "wifi"
  ],
  "debug": {
    "openocd_target": "esp32s3.cfg"
  },
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "name": "esp32-PANDATOUCH",
  "upload": {
    "flash_size": "16MB",
    "maximum_ram_size": 327680,
    "maximum_size": 16777216,
    "use_1200bps_touch": true,
    "wait_for_upload_port": true,
    "require_upload_port": true,
    "speed": 460800
  },
  "url": "https://github.com/bigtreetech/PandaTouch",
  "vendor": "BTT"
}
